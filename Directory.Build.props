<Project>
  <!--
    TestHarness는 GameProject1/{DevTools, Server, Unity, TestHarness} 폴더 배치를 전제로 한다
    (Server/Directory.Build.props가 Unity 경로를 계산할 때 쓰는 것과 같은 전제).

    proto 계약은 Server의 *.Contracts 프로젝트를 참조하지 않고 .proto 파일을 직접 가져와
    클라이언트 코드만 생성한다 - Contracts 프로젝트를 참조하면 그쪽의 CopyGeneratedToUnity
    빌드 단계가 같이 돌아서 TestHarness를 빌드할 때마다 Unity 폴더가 바뀌기 때문이다.
  -->
  <PropertyGroup>
    <ServerSharedDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Server\GameServer\Shared'))</ServerSharedDir>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
