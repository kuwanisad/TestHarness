<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TestHarness.HeadlessClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 서버(Grpc.AspNetCore 2.63.0 / Google.Protobuf 3.27.2)와 같은 버전대로 맞춘다. -->
    <PackageReference Include="Google.Protobuf" Version="3.27.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.63.0" />
    <PackageReference Include="Grpc.Tools" Version="2.63.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 클라 입장에서 필요한 계약만, 클라이언트 스텁만 생성한다. -->
    <Protobuf Include="$(ServerSharedDir)\Common.Contracts\Protos\common.proto"
              Link="Protos\common.proto" GrpcServices="None" />
    <Protobuf Include="$(ServerSharedDir)\LoginServer.Contracts\Protos\login.proto"
              Link="Protos\login.proto" GrpcServices="Client"
              AdditionalImportDirs="$(ServerSharedDir)\Common.Contracts\Protos" />
    <Protobuf Include="$(ServerSharedDir)\LobbyServer.Contracts\Protos\lobby.proto"
              Link="Protos\lobby.proto" GrpcServices="Client"
              AdditionalImportDirs="$(ServerSharedDir)\Common.Contracts\Protos" />
  </ItemGroup>

</Project>
